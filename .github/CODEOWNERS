# Code owners are requested for review automatically on every PR touching
# a matching path. Combined with the branch protection rule on `main`, which
# requires review from Code Owners, these reviewers are mandatory.
#
# Owners must have write access to the repo or the rule is silently ignored.

# Default owner for everything in the repo.
*                       @sambit-srcm

# Build, tooling and CI configuration.
/.github/               @sambit-srcm
/.husky/                @sambit-srcm
/*.config.*             @sambit-srcm
/package.json           @sambit-srcm
/package-lock.json      @sambit-srcm

# Security-sensitive configuration.
/.gitleaks.toml         @sambit-srcm
/.env.example           @sambit-srcm
