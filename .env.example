# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for metadata and OpenGraph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chain the dApp connects to (e.g. 1 = mainnet, 11155111 = sepolia).
NEXT_PUBLIC_CHAIN_ID="11155111"

# Deployed NFT contract address.
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# RPC / indexer endpoints. Server-only values must NOT use the NEXT_PUBLIC_ prefix.
RPC_URL=""
